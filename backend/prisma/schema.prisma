// Database schema. Design and reasoning: docs/erd.md
//
// CHECK constraints and partial unique indexes can't be expressed here; they
// live in a hand-written SQL migration (see prisma/migrations).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// The connection URL lives in prisma.config.ts (CLI) and PrismaService (runtime).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

enum UserRole {
  PASSENGER
  DRIVER

  @@map("user_role")
}

enum RideStatus {
  REQUESTED
  MATCHED
  DRIVER_ARRIVED
  STARTED
  COMPLETED
  CANCELLED

  @@map("ride_status")
}

enum PoolStatus {
  MATCHED
  DRIVER_ARRIVED
  STARTED
  COMPLETED
  CANCELLED

  @@map("pool_status")
}

enum ActorType {
  PASSENGER
  DRIVER
  SYSTEM

  @@map("actor_type")
}

enum PaymentMethod {
  CASH

  @@map("payment_method")
}

// ---------------------------------------------------------------- people & vehicles

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole
  isOnline     Boolean  @default(false) @map("is_online")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  vehicle       Vehicle?
  rideRequests  RideRequest[]
  pools         Pool[]
  statusChanges RideStatusHistory[]

  @@map("users")
}

model Vehicle {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driverId    String   @unique @map("driver_id") @db.Uuid
  name        String   @db.VarChar(50)
  plateNumber String   @unique @map("plate_number") @db.VarChar(20)
  capacity    Int      @db.SmallInt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  driver User   @relation(fields: [driverId], references: [id], onDelete: Restrict)
  pools  Pool[]

  @@map("vehicles")
}

// ---------------------------------------------------------------- geography

model Zone {
  id   Int     @id @default(autoincrement()) @db.SmallInt
  code String  @unique @db.VarChar(10)
  name String  @unique @db.VarChar(50)
  lat  Decimal @db.Decimal(9, 6)
  lng  Decimal @db.Decimal(9, 6)

  distancesFrom       ZoneDistance[] @relation("DistanceFrom")
  distancesTo         ZoneDistance[] @relation("DistanceTo")
  pickupRequests      RideRequest[]  @relation("RequestPickup")
  destinationRequests RideRequest[]  @relation("RequestDestination")
  pools               Pool[]

  @@map("zones")
}

model ZoneDistance {
  fromZoneId Int @map("from_zone_id") @db.SmallInt
  toZoneId   Int @map("to_zone_id") @db.SmallInt
  distanceKm Int @map("distance_km") @db.SmallInt

  fromZone Zone @relation("DistanceFrom", fields: [fromZoneId], references: [id], onDelete: Restrict)
  toZone   Zone @relation("DistanceTo", fields: [toZoneId], references: [id], onDelete: Restrict)

  @@id([fromZoneId, toZoneId])
  @@map("zone_distances")
}

// ---------------------------------------------------------------- rides & pools

model RideRequest {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  passengerId        String     @map("passenger_id") @db.Uuid
  pickupZoneId       Int        @map("pickup_zone_id") @db.SmallInt
  destinationZoneId  Int        @map("destination_zone_id") @db.SmallInt
  pickupNote         String?    @map("pickup_note") @db.VarChar(200)
  seats              Int        @db.SmallInt
  distanceKm         Int        @map("distance_km") @db.SmallInt
  estimatedFarePaisa Int        @map("estimated_fare_paisa")
  status             RideStatus @default(REQUESTED)
  cancelReason       String?    @map("cancel_reason") @db.VarChar(200)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  passenger       User                @relation(fields: [passengerId], references: [id], onDelete: Restrict)
  pickupZone      Zone                @relation("RequestPickup", fields: [pickupZoneId], references: [id], onDelete: Restrict)
  destinationZone Zone                @relation("RequestDestination", fields: [destinationZoneId], references: [id], onDelete: Restrict)
  memberships     PoolMember[]
  history         RideStatusHistory[]

  @@index([passengerId, createdAt(sort: Desc)])
  @@index([status, pickupZoneId, createdAt])
  @@map("ride_requests")
}

model Pool {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driverId      String     @map("driver_id") @db.Uuid
  vehicleId     String     @map("vehicle_id") @db.Uuid
  pickupZoneId  Int        @map("pickup_zone_id") @db.SmallInt
  capacity      Int        @db.SmallInt
  occupiedSeats Int        @default(0) @map("occupied_seats") @db.SmallInt
  status        PoolStatus @default(MATCHED)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  arrivedAt     DateTime?  @map("arrived_at") @db.Timestamptz(6)
  startedAt     DateTime?  @map("started_at") @db.Timestamptz(6)
  completedAt   DateTime?  @map("completed_at") @db.Timestamptz(6)
  cancelledAt   DateTime?  @map("cancelled_at") @db.Timestamptz(6)
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  driver     User                @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicle    Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  pickupZone Zone                @relation(fields: [pickupZoneId], references: [id], onDelete: Restrict)
  members    PoolMember[]
  history    RideStatusHistory[]

  @@index([status, pickupZoneId, createdAt])
  @@index([driverId, createdAt(sort: Desc)])
  @@map("pools")
}

model PoolMember {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  poolId              String        @map("pool_id") @db.Uuid
  rideRequestId       String        @map("ride_request_id") @db.Uuid
  seats               Int           @db.SmallInt
  dropOffOrder        Int           @map("drop_off_order") @db.SmallInt
  distanceKm          Int           @map("distance_km") @db.SmallInt
  baseFarePaisa       Int?          @map("base_fare_paisa")
  perKmRatePaisa      Int?          @map("per_km_rate_paisa")
  distanceChargePaisa Int?          @map("distance_charge_paisa")
  subtotalPaisa       Int?          @map("subtotal_paisa")
  poolDiscountBps     Int?          @map("pool_discount_bps") @db.SmallInt
  poolDiscountPaisa   Int?          @map("pool_discount_paisa")
  finalFarePaisa      Int?          @map("final_fare_paisa")
  fareLockedAt        DateTime?     @map("fare_locked_at") @db.Timestamptz(6)
  paymentMethod       PaymentMethod @default(CASH) @map("payment_method")
  paidAt              DateTime?     @map("paid_at") @db.Timestamptz(6)
  joinedAt            DateTime      @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt              DateTime?     @map("left_at") @db.Timestamptz(6)
  // Set when the driver drops this passenger off during the trip.
  droppedAt           DateTime?     @map("dropped_at") @db.Timestamptz(6)

  pool        Pool        @relation(fields: [poolId], references: [id], onDelete: Restrict)
  rideRequest RideRequest @relation(fields: [rideRequestId], references: [id], onDelete: Restrict)

  @@index([poolId])
  @@index([rideRequestId])
  @@map("pool_members")
}

model RideStatusHistory {
  id            BigInt      @id @default(autoincrement())
  rideRequestId String      @map("ride_request_id") @db.Uuid
  poolId        String?     @map("pool_id") @db.Uuid
  fromStatus    RideStatus? @map("from_status")
  toStatus      RideStatus  @map("to_status")
  actorType     ActorType   @map("actor_type")
  actorId       String?     @map("actor_id") @db.Uuid
  reason        String?     @db.VarChar(200)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  rideRequest RideRequest @relation(fields: [rideRequestId], references: [id], onDelete: Restrict)
  pool        Pool?       @relation(fields: [poolId], references: [id], onDelete: Restrict)
  actor       User?       @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([rideRequestId, createdAt])
  @@map("ride_status_history")
}
