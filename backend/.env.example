# Copy to .env for local development (npm run start:dev, tests).
# Values match the Postgres started by `docker compose up postgres`.

PORT=4000

# Used by the running app. On Neon this is the pooled connection string.
DATABASE_URL=postgresql://tesla:tesla@localhost:5433/dhaka_tesla_pool

# Used by Prisma migrations. On Neon this is the direct (unpooled) string;
# locally it is the same database.
DIRECT_URL=postgresql://tesla:tesla@localhost:5433/dhaka_tesla_pool
