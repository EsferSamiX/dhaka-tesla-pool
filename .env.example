# Docker Compose settings. Copy to .env to override the defaults.
# These values are for local development only; never commit a real .env.

# PostgreSQL
POSTGRES_USER=tesla
POSTGRES_PASSWORD=tesla
POSTGRES_DB=dhaka_tesla_pool

# Secret for signing session tokens. Use a long random value outside local
# development, e.g. `openssl rand -base64 48`.
JWT_SECRET=dev-only-change-me

# Host ports (change if something else already uses them).
# Postgres uses 5433 on the host so it doesn't clash with a locally
# installed PostgreSQL on 5432; inside Docker it is still 5432.
POSTGRES_PORT=5433
BACKEND_PORT=4000
FRONTEND_PORT=3000
